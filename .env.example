# Example configuration for ai-reader-2 — copy to `.env` and adjust.
# `.env` itself is git-ignored; only this example is tracked.

# --- Server ---
# BIND address and port for uvicorn (server.py defaults: 0.0.0.0:8123).
READER_HOST=0.0.0.0
READER_PORT=8123

# --- AI provider (Ollama local / Ollama Cloud; takes effect with the AI
# --- features; server.py prints whether .env was found) ---
# Local Ollama's OpenAI-compatible endpoint:
OLLAMA_BASE_URL=http://localhost:11434/v1
# Any non-empty value works for a local Ollama; a real key for Ollama Cloud:
OLLAMA_API_KEY=ollama
# Local model:
OLLAMA_MODEL=llama3
# Cloud model:
OLLAMA_CLOUD_MODEL=gpt-oss:120b-cloud