# Example configuration for ai-reader-2 — copy to `.env` and fill in.
# `.env` itself is git-ignored; only this example is tracked.
#
# Every AI setting lives here: the code has no built-in endpoint, key or model.
# A provider whose settings are missing reports which variable is unset.

# --- Server ---
# BIND address and port for uvicorn.
READER_HOST=0.0.0.0
READER_PORT=8123

# --- Which provider the panel opens on: ollama (local) or cline (remote) ---
OLLAMA_DEFAULT_PROVIDER=ollama
# Seconds to wait for one AI reply (both providers).
AI_TIMEOUT=60

# --- Local provider (`ollama`): an Ollama server, free and unlimited ---
# Its OpenAI-compatible endpoint, e.g. a LAN host:
OLLAMA_BASE_URL=http://localhost:11434/v1
# Sent as `Authorization: Bearer ...`.
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3

# --- Remote provider (`cline`): the Cline API, billed to your Cline account ---
CLINE_BASE_URL=https://api.cline.bot/api/v1
# Key from https://app.cline.bot (Settings > API Keys).
CLINE_KEY=
# Model ids are `provider/model`, e.g. anthropic/claude-haiku-5.5.
CLINE_MODEL=anthropic/claude-haiku-5.5
