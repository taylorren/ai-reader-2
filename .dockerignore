# Version control
.git/
.github/
.gitignore

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Runtime data — never bake user data into the image
books/
temp/
uvtmp/
reader_data.db
reader_data.db-wal
reader_data.db-shm
test.db
test.db-wal
test.db-shm
*.db.backup
backups/
reader_data_*.json

# Secrets — a container gets these from its environment or a mounted .env
.env
.env.*

# Not needed at runtime
tests/
scripts/
*.md
*.png

# ...but Docker Hub renders the README from inside the image, so keep it.
!README.md
