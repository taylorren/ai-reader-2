# Python-generated files
__pycache__/
*.py[oc]
.pytest_cache/
build/
dist/
wheels/
*.egg-info

# No pickle, ever (SPEC.md): books stay EPUBs, annotations stay SQLite
*.pkl

# Virtual environments
.venv

# The library itself: books are user data, never committed
*.epub
books/*
!books/.gitkeep

